{
  "name": "@hotelos-apps/guestops-ui",
  "version": "0.1.0",
  "description": "GuestOps's packaged desktop module \u2014 the reservation book.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "esbuild main.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=../.build/pkg/ui/module.js --alias:@hotelos/sdk=../../../HosPilotOS/packages/sdk-typescript/src/index.ts",
    "harness": "esbuild preview/frame.ts --bundle --format=esm --outfile=preview/frame.js --alias:@hotelos/sdk=../../../HosPilotOS/packages/sdk-typescript/src/index.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.12.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
