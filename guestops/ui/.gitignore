node_modules/
package-lock.json
preview/*.js
module.js
widgets/*.js
preview/widget-frame.js
gallery.html

# Part A sweep output — measurements of a build, regenerated by
# `node preview/parta/run.mjs`. Not a source, and not evidence once the
# artifacts it measured have been rebuilt.
.parta/

# App surface checklist audit output — `node preview/audit/run.mjs`. The same
# reason: evidence about one build, and none once that build is replaced.
.audit/
