{
  "name": "@hotelos-apps/jobs-ui",
  "version": "0.1.0",
  "description": "Jobs' packaged desktop module — the board, a job, raising, resolving, the live tab, the catalogue and the settings.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:module && npm run build:widgets",
    "build:module": "node ../../scripts/build-module.mjs",
    "build:widgets": "node ../../scripts/build-module.mjs widgets/jobs-now.js widgets/entry/jobs-now.ts",
    "test": "npm run build && vitest run",
    "capture": "esbuild preview/frame.ts --bundle --format=esm --outfile=preview/frame.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.12.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
