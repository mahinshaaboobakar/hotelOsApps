<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Room Care — are the rooms ready, as an installable application.

    ADR 0122: a package, developed in its own repository, binding to HotelOS at
    exactly one point — the signed `.hopkg` install. It depends on the
    platform's SDK through the sibling-path reference Jobs, Workforce and
    GuestOps use, never on a platform service.

    Design of record: `roomcare/docs/chapters/03-the-roomcare-design.md`.
    Master Data is read through the install grant (ADR 0092 §4), never over the
    wire; the room is Master Data's and its condition is this application's
    (ADR 0044, 0051, 0056).
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HotelOS.RoomCare</RootNamespace>
    <!-- Fixed: the manifest names it, and install step 6 runs
         `dotnet backend/HotelOS.RoomCare.dll migrate`. -->
    <AssemblyName>HotelOS.RoomCare</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformRoot>..\..\..\..\HosPilotOS</PlatformRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(PlatformRoot)\packages\sdk-dotnet\HotelOS.Platform\HotelOS.Platform.csproj" />
  </ItemGroup>

</Project>
