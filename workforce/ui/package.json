{
  "name": "@hotelos-apps/workforce-ui",
  "version": "0.1.0",
  "description": "Workforce's packaged desktop module — the rota, leave, attendance and the numbers.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild main.ts --bundle --format=esm --platform=browser --target=es2022 --alias:@hotelos/sdk=../../../HosPilotOS/packages/sdk-typescript/src/index.ts --outfile=module.js && node ../../scripts/verify-module.mjs module.js",
    "test": "npm run build && vitest run",
    "capture": "esbuild preview/frame.ts --bundle --format=esm --outfile=preview/frame.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.12.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
